          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ada Byron\",\n  \"username\": \"{{updatedUsername}}\",\n  \"currentPassword\": \"wrong-password\"\n}" },
            "url": "{{baseUrl}}/api/customers/me"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Wrong current password is rejected', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ] }
          }]
        },
        {
          "name": "Reject duplicate profile username",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ada Byron\",\n  \"username\": \"{{runUsername2}}\",\n  \"currentPassword\": \"password123\"\n}" },
            "url": "{{baseUrl}}/api/customers/me"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Existing username is rejected', function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ] }
          }]
        },
        {
          "name": "Update username and password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ada Byron\",\n  \"username\": \"{{updatedUsername}}\",\n  \"currentPassword\": \"password123\",\n  \"newPassword\": \"newpassword123\"\n}" },
            "url": "{{baseUrl}}/api/customers/me"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Username and password changed without changing the customer ID', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().id).to.equal(pm.collectionVariables.get('customerId'));",
              "    pm.expect(pm.response.json().username).to.equal(pm.collectionVariables.get('updatedUsername'));",
              "});"
            ] }
          }]
        },
        {
          "name": "Log in with updated credentials",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{updatedUsername}}\",\n  \"password\": \"newpassword123\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('New credentials can sign in', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().customerId).to.equal(pm.collectionVariables.get('customerId'));",
              "});",
              "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"
            ] }
          }]
        },
        {
          "name": "Get updated profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/customers/me" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('New token resolves the same customer and updated profile', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().id).to.equal(pm.collectionVariables.get('customerId'));",
              "    pm.expect(pm.response.json().name).to.equal('Ada Byron');",
              "    pm.expect(pm.response.json().username).to.equal(pm.collectionVariables.get('updatedUsername'));",
              "});"
            ] }
          }]
        }
      ]
    },
    {
      "name": "Account deletion",
      "item": [
        {
          "name": "Create empty account to delete",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{customerId}}\",\n  \"accountType\": \"CHECKING\"\n}" },
            "url": "{{baseUrl}}/api/accounts"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Empty account created for deletion', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(Number(pm.response.json().balance)).to.equal(0);",
              "});",
              "if (pm.response.code === 201) pm.collectionVariables.set('deletableAccountId', pm.response.json().id);"
            ] }
          }]
        },
        {
          "name": "Reject deletion with funds",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/accounts/{{savingsAccountId}}" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Funded account cannot be deleted', function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ] }
          }]
        },
        {
          "name": "Reject deletion of another customer's account",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/accounts/{{savingsAccountId2}}" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Customer cannot delete another customer account', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ] }
          }]
        },
        {
          "name": "Delete empty account",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/accounts/{{deletableAccountId}}" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Zero-balance account deleted', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ] }
          }]
        },
        {
          "name": "Verify empty account was deleted",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/accounts/{{deletableAccountId}}" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Deleted account is not found', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ] }
          }]
        }
      ]
    }
  ]
}