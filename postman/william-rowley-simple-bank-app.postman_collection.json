    {
      "name": "Account ownership checks",
      "item": [
        {
          "name": "Customer cannot read another account",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/{{savingsAccountId2}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Account owner check denies cross-customer reads', function () {",
                "    pm.response.to.have.status(403);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Customer cannot deposit into another account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 10\n}" },
            "url": "{{baseUrl}}/api/accounts/{{savingsAccountId2}}/deposit"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Account owner check denies cross-customer deposits', function () {",
                "    pm.response.to.have.status(403);",
                "});"
              ]
            }
          }]
        },
