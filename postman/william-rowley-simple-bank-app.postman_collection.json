                "    pm.response.to.have.status(200);",
                "    const accounts = pm.response.json();",
                "    pm.expect(accounts).to.have.length(1);",
                "    pm.expect(accounts[0].id).to.equal(pm.collectionVariables.get('savingsAccountId2'));",
                "    pm.expect(accounts[0].userId).to.equal(pm.collectionVariables.get('customerId2'));",
                "});"
              ]
            }
          }]
