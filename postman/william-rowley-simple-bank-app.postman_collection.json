{
  "info": {
    "name": "Simple Bank App API",
    "description": "Runnable requests for the Simple Bank App Spring Boot API. Start the backend at http://localhost:8080 before sending requests. Register and log in first so the JWT is stored for protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "token2",
      "value": ""
    },
    {
      "key": "customerId",
      "value": "1"
    },
    {
      "key": "customerId2",
      "value": "2"
    },
    {
      "key": "savingsAccountId",
      "value": "1"
    },
    {
      "key": "checkingAccountId",
      "value": "2"
    },
    {
      "key": "savingsAccountId2",
      "value": "3"
    },
    {
      "key": "checkingAccountId2",
      "value": "4"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"username\": \"{{runUsername}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('runUsername', 'ada-' + runId);",
                  "pm.collectionVariables.set('runUsername2', 'charles-' + runId);",
                  "['token', 'token2', 'customerId', 'customerId2', 'savingsAccountId', 'checkingAccountId', 'savingsAccountId2', 'deletableAccountId'].forEach(key => pm.collectionVariables.unset(key));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration succeeded', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const customer = pm.response.json();",
                  "pm.collectionVariables.set('customerId', customer.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{runUsername}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const login = pm.response.json();",
                  "pm.collectionVariables.set('token', login.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject duplicate username",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Another Ada\",\n  \"username\": \"{{runUsername}}\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Duplicate username is rejected', function () {",
                "    pm.response.to.have.status(409);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Reject incorrect password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{runUsername}}\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Incorrect password is rejected', function () {",
                "    pm.expect([401, 403]).to.include(pm.response.code);",
                "});"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create savings account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{customerId}}\",\n  \"accountType\": \"SAVINGS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Savings account created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const account = pm.response.json();",
                  "pm.collectionVariables.set('savingsAccountId', account.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create checking account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{customerId}}\",\n  \"accountType\": \"CHECKING\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Checking account created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const account = pm.response.json();",
                  "pm.collectionVariables.set('checkingAccountId', account.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my accounts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/me"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Customer sees only their own accounts', function () {",
                "    pm.response.to.have.status(200);",
                "    const accounts = pm.response.json();",
                "    pm.expect(accounts).to.have.length(2);",
                "    pm.expect(accounts.every(account => account.userId === pm.collectionVariables.get('customerId'))).to.equal(true);",
                "    pm.expect(accounts.map(account => account.accountType)).to.have.members(['SAVINGS', 'CHECKING']);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Get account details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{savingsAccountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{savingsAccountId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Account found', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Money Operations",
