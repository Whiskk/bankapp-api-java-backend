                  "    pm.expect(Number(pm.response.json().balance)).to.equal(300);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer money",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{savingsAccountId}}\",\n  \"toAccountId\": \"{{checkingAccountId}}\",\n  \"amount\": 100.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "transfer"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Transfer succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(Number(pm.response.json().balance)).to.equal(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get checking balance after transfer",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/{{checkingAccountId}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Destination account received the transfer', function () {",
                "    pm.response.to.have.status(200);",
                "    pm.expect(Number(pm.response.json().balance)).to.equal(100);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Get checking transaction history",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/{{checkingAccountId}}/transactions"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Destination account records the transfer', function () {",
                "    pm.response.to.have.status(200);",
                "    const history = pm.response.json();",
                "    pm.expect(history).to.have.length(1);",
                "    pm.expect(history[0].type).to.equal('TRANSFER');",
                "    pm.expect(Number(history[0].balanceAfter)).to.equal(100);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Get transaction history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{savingsAccountId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{savingsAccountId}}",
                "transactions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Transaction history loaded', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const history = pm.response.json();",
                  "    pm.expect(history).to.have.length(3);",
                  "    pm.expect(history.map(entry => entry.type)).to.have.members(['DEPOSIT', 'WITHDRAWAL', 'TRANSFER']);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
